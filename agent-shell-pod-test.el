      (agent-shell-pod-test--session repo "Refactor auth" 'ready "Opus 4.5")
      (agent-shell-pod-test--session wt "Promo codes" 'waiting "gpt-5")
      (let ((text (agent-shell-pod-test--render-plain #'agent-shell-pod--render-sidebar 38)))
        (should (string-match-p "▾ acme-web +◉1 2" text))
        (should (string-match-p "main +primary" text))
        (should (string-match-p "◉ Promo codes +gpt-5 now" text))
        (should (string-match-p "Needs your input" text))
        (should (string-match-p "\\+ New agent" text))
        (should (string-match-p "ctx  ███████░░░ 68%" text)))
      (with-temp-buffer
        (agent-shell-pod--render-sidebar 38)
        (goto-char (point-min))
        (should (eq (plist-get (agent-shell-pod--item-at) :type) 'project))
        (agent-shell-pod-next-item)
        (should (eq (plist-get (agent-shell-pod--item-at) :type) 'worktree))
        (agent-shell-pod-next-item 2)
        (should (eq (plist-get (agent-shell-pod--item-at) :type) 'worktree))
        (agent-shell-pod-next-item)
        (should (equal (plist-get (agent-shell-pod--item-at) :title) "Promo codes"))
        (agent-shell-pod-next-item)
        (should (eq (plist-get (agent-shell-pod--item-at) :type) 'new))
        (agent-shell-pod-previous-item)
        (should (equal (plist-get (agent-shell-pod--item-at) :title) "Promo codes"))
        (should (equal (agent-shell-pod--context)
                       (cons repo (file-name-as-directory wt))))))))

(ert-deftest agent-shell-pod-test-folding ()
