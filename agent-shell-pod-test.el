(ert-deftest agent-shell-pod-test-evil-keys ()
  (skip-unless (require 'evil nil t))
  (let ((agent-shell-pod--keys-ready nil)
        (agent-shell-pod-leader-key nil)
        (agent-shell-pod-localleader-key nil))
    (evil-mode 1)
    (unwind-protect
        (progn
          (agent-shell-pod-setup-keys)
          (with-temp-buffer
            (agent-shell-pod-sidebar-mode)
            (evil-local-mode 1)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "j")) 'agent-shell-pod-next-item))
            (should (eq (key-binding (kbd "J")) 'agent-shell-pod-next-attention))
            (should (eq (key-binding (kbd "gr")) 'agent-shell-pod-refresh))
            (should (eq (key-binding (kbd "?")) 'agent-shell-pod-sidebar-menu))
            (should (eq (key-binding (kbd "q")) 'agent-shell-pod-quit))
            (should (eq (key-binding (kbd "RET")) 'agent-shell-pod-visit)))
          (with-temp-buffer
            (agent-shell-pod-dashboard-mode)
            (evil-local-mode 1)
            (should (eq (key-binding (kbd "x")) 'agent-shell-pod-kill))))
      (evil-mode -1))))

(defvar agent-shell-pod-test--map-calls nil)

(ert-deftest agent-shell-pod-test-doom-keys ()
  (let ((agent-shell-pod--keys-ready nil)
        (agent-shell-pod-test--map-calls nil))
    (unwind-protect
        (progn
          (defalias 'map! (cons 'macro (lambda (&rest args)
                                         `(push ',args agent-shell-pod-test--map-calls))))
          (agent-shell-pod-setup-keys)
          (should (member '(:leader :desc "Agents" "l" #'agent-shell-pod-menu)
                          agent-shell-pod-test--map-calls))
          (should (member '(:map agent-shell-mode-map :localleader
                                 :desc "Agent menu" "l" #'agent-shell-pod-session-menu)
                          agent-shell-pod-test--map-calls))
          (setq agent-shell-pod-test--map-calls nil)
          (agent-shell-pod-setup-keys)
          (should-not agent-shell-pod-test--map-calls))
      (fmakunbound 'map!))))

(ert-deftest agent-shell-pod-test-quit ()
  (let ((called nil))
    (cl-letf (((symbol-function 'agent-shell-pod-toggle) (lambda () (setq called 'toggle)))
              ((symbol-function 'quit-window) (lambda (&rest _) (setq called 'quit))))
      (with-temp-buffer
        (agent-shell-pod-sidebar-mode)
        (agent-shell-pod-quit)
        (should (eq called 'toggle)))
      (with-temp-buffer
        (agent-shell-pod-dashboard-mode)
        (agent-shell-pod-quit)
        (should (eq called 'quit))))))

