      (should (eq (agent-shell-pod--status buffer) 'ready)))))

(ert-deftest agent-shell-pod-test-attention-queue-order ()
  (agent-shell-pod-test--with-env
    (let ((a (agent-shell-pod-test--session tmp "Finished one"))
          (b (agent-shell-pod-test--session tmp "Waiting one" 'waiting))
          (c (agent-shell-pod-test--session tmp "Idle one"))
          (d (agent-shell-pod-test--session tmp "Broken one")))
      (ignore c)
      (with-current-buffer a (setq agent-shell-pod--finished t))
      (with-current-buffer d (setq agent-shell-pod--error "boom"))
      (should (equal (agent-shell-pod--attention-queue) (list b d a))))))

