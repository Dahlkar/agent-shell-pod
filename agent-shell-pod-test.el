(ert-deftest agent-shell-pod-test-toggle-focus-main-window ()
  (agent-shell-pod-test--with-env
    (let* ((repo (agent-shell-pod-test--repo tmp "acme"))
           (file (expand-file-name "a.txt" repo))
           (agent-shell-pod-session-display 'main-window))
      (with-temp-file file (insert "x"))
      (let ((code (find-file-noselect file))
            (agent (agent-shell-pod-test--session repo "Task")))
        (push code file-buffers)
        (agent-shell-pod-test--with-windows
          (switch-to-buffer code)
          (agent-shell-pod-toggle-focus)
          (should (eq (window-buffer (selected-window)) agent))
          (should (= 1 (length (window-list))))
          (agent-shell-pod-toggle-focus)
          (should (eq (window-buffer (selected-window)) code))
          (agent-shell-pod-toggle-agent-window)
          (should (eq (window-buffer (selected-window)) agent))
          (agent-shell-pod-toggle-agent-window)
          (should (eq (window-buffer (selected-window)) code)))))))

(ert-deftest agent-shell-pod-test-toggle-focus-side-window ()
  (agent-shell-pod-test--with-env
    (let* ((repo (agent-shell-pod-test--repo tmp "acme"))
           (file (expand-file-name "a.txt" repo))
           (agent-shell-pod-session-display 'side-window))
      (with-temp-file file (insert "x"))
