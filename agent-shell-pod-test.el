;;; agent-shell-pod-test.el --- Tests for agent-shell-pod -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'agent-shell-pod)

(defvar-local agent-shell-pod-test--status 'ready)
(defvar agent-shell-pod-test--buffers nil)

(defun agent-shell-pod-test--git (dir &rest args)
  (let ((default-directory (file-name-as-directory dir)))
    (with-temp-buffer
      (unless (eq 0 (apply #'call-process "git" nil t nil args))
        (error "git %S: %s" args (buffer-string))))))

(defun agent-shell-pod-test--repo (parent name)
  (let ((dir (expand-file-name name parent)))
    (make-directory dir t)
    (agent-shell-pod-test--git dir "init" "-q" "-b" "main")
    (agent-shell-pod-test--git dir "-c" "user.email=t@t" "-c" "user.name=t"
                               "commit" "-q" "--allow-empty" "-m" "init")
    (file-name-as-directory dir)))

(defun agent-shell-pod-test--session (dir title &optional status model)
  (let ((buffer (generate-new-buffer (format "*fake %s*" title))))
    (with-current-buffer buffer
      (setq major-mode 'agent-shell-mode)
      (setq default-directory (file-name-as-directory dir))
      (setq-local agent-shell--state
                  (list (cons :session (list (cons :id "sid") (cons :title title)))
                        (cons :agent-config (list (cons :mode-line-name "Claude Code")))
                        (cons :usage (list (cons :context-used 68000)
                                           (cons :context-size 100000)
                                           (cons :cost-amount 0.42)))
                        (cons :test-model model)
                        (cons :event-subscriptions nil)))
      (setq agent-shell-pod-test--status (or status 'ready))
      (setq agent-shell-pod--created (float-time))
      (let ((process-connection-type nil))
        (set-process-query-on-exit-flag (start-process "fake" buffer "cat") nil)))
    (push buffer agent-shell-pod-test--buffers)
    buffer))

(defmacro agent-shell-pod-test--with-env (&rest body)
  (declare (indent 0))
  `(let* ((tmp (file-name-as-directory (make-temp-file "pod-test" t)))
          (agent-shell-pod-test--buffers nil)
          (agent-shell-pod--cache (make-hash-table :test 'equal))
          (agent-shell-pod--folded (make-hash-table :test 'equal))
          (agent-shell-pod--extra-roots nil)
          (agent-shell-pod--hidden-roots nil)
          (agent-shell-pod-project-sources '(open sessions))
          (project-list-file (expand-file-name "projects" tmp))
          (file-buffers nil))
     (cl-letf (((symbol-function 'agent-shell-buffers)
                (lambda () (seq-filter #'buffer-live-p agent-shell-pod-test--buffers)))
               ((symbol-function 'agent-shell-status)
                (cl-function (lambda (&key shell-buffer)
                               (pcase (buffer-local-value 'agent-shell-pod-test--status shell-buffer)
                                 ('waiting 'blocked) ('working 'busy) (_ 'ready)))))
               ((symbol-function 'agent-shell-get-model-name)
                (lambda (state) (map-elt state :test-model))))
       (unwind-protect
           (progn ,@body)
         (dolist (b (append agent-shell-pod-test--buffers file-buffers))
           (when (buffer-live-p b)
             (let ((kill-buffer-query-functions nil)) (kill-buffer b))))
         (delete-directory tmp t)))))

(defun agent-shell-pod-test--render (fn width)
  (with-temp-buffer
    (funcall fn width)
    (buffer-substring-no-properties (point-min) (point-max))))

(defun agent-shell-pod-test--plain (text)
  (with-temp-buffer
    (insert text)
    (goto-char (point-min))
    (let (out)
      (while (not (eobp))
        (let* ((bol (point))
               (eol (line-end-position))
               (line ""))
          (while (< (point) eol)
            (let* ((next (or (next-single-property-change (point) 'display nil eol) eol))
                   (display (get-text-property (point) 'display)))
              (setq line
                    (concat line
                            (if (eq (car-safe display) 'space)
                                (make-string (max 1 (- (plist-get (cdr display) :align-to)
                                                       (string-width line)))
                                             ?\s)
                              (buffer-substring-no-properties (point) next))))
              (goto-char next)))
          (ignore bol)
          (push line out)
          (forward-line 1)))
      (string-join (nreverse out) "\n"))))

(defun agent-shell-pod-test--render-plain (fn width)
  (with-temp-buffer
    (funcall fn width)
    (agent-shell-pod-test--plain (buffer-string))))

(ert-deftest agent-shell-pod-test-groups-worktrees-under-main-project ()
  (agent-shell-pod-test--with-env
    (let* ((repo (agent-shell-pod-test--repo tmp "acme-web"))
           (wt (expand-file-name ".agent-shell/worktrees/checkout" repo))
           (plain (expand-file-name "notes" tmp)))
      (make-directory plain t)
      (with-temp-file (expand-file-name ".project" plain) (insert ""))
      (agent-shell-pod-test--git repo "worktree" "add" "-q" "-b" "feat/checkout" wt)
      (agent-shell-pod-test--session repo "Refactor auth")
      (agent-shell-pod-test--session wt "Checkout flow" 'working "Opus 4.5")
      (let ((project-vc-extra-root-markers '(".project")))
        (agent-shell-pod-test--session plain "Write docs")
        (let* ((projects (agent-shell-pod--collect))
               (acme (seq-find (lambda (p) (equal (plist-get p :name) "acme-web")) projects)))
          (should (= 2 (length projects)))
          (should (equal (plist-get acme :root) repo))
          (should (= 2 (length (plist-get acme :sessions))))
          (should (equal (mapcar (lambda (w) (plist-get w :branch)) (plist-get acme :worktrees))
                         '("main" "feat/checkout")))
          (should (plist-get (car (plist-get acme :worktrees)) :primary)))))))

(ert-deftest agent-shell-pod-test-open-buffers-make-projects-appear ()
  (agent-shell-pod-test--with-env
    (let* ((repo (agent-shell-pod-test--repo tmp "infra"))
           (file (expand-file-name "main.tf" repo)))
      (with-temp-file file (insert "x"))
      (push (find-file-noselect file) file-buffers)
      (let ((projects (agent-shell-pod--collect)))
        (should (equal (mapcar (lambda (p) (plist-get p :name)) projects) '("infra")))
        (should (agent-shell-pod--folded-p (car projects))))
      (let ((agent-shell-pod--hidden-roots (list repo)))
        (should-not (agent-shell-pod--collect))))))

(ert-deftest agent-shell-pod-test-status-and-events ()
  (agent-shell-pod-test--with-env
    (let* ((repo (agent-shell-pod-test--repo tmp "acme"))
           (buffer (agent-shell-pod-test--session repo "Task"))
           (notified nil)
           (agent-shell-pod-notify-function (lambda (title body _b) (push (cons title body) notified))))
      (should (eq (agent-shell-pod--status buffer) 'ready))
      (with-current-buffer buffer
        (agent-shell-pod--on-event '((:event . input-submitted)))
        (setq agent-shell-pod-test--status 'working)
        (should (eq (agent-shell-pod--status buffer) 'working))
        (setq agent-shell-pod--busy-since (- (float-time) 134))
        (setq agent-shell-pod-test--status 'ready)
        (agent-shell-pod--on-event '((:event . turn-complete) (:data (:stop-reason . "end_turn")))))
      (should (eq (agent-shell-pod--status buffer) 'finished))
      (should (equal (agent-shell-pod--status-text (agent-shell-pod--session-info buffer))
                     "Worked for 2m 14s"))
      (should (equal (car notified) '("Task · acme" . "Finished in 2m 14s")))
      (with-current-buffer buffer
        (setq agent-shell-pod-test--status 'waiting)
        (agent-shell-pod--on-event '((:event . permission-request)
                                     (:data (:tool-call (:title . "rm -rf dist"))))))
      (should (eq (agent-shell-pod--status buffer) 'waiting))
      (should (equal (cdar notified) "Needs permission: rm -rf dist"))
      (with-current-buffer buffer
        (delete-process (get-buffer-process buffer)))
      (should (eq (agent-shell-pod--status buffer) 'killed)))))

(ert-deftest agent-shell-pod-test-cancelled-turn-is-not-finished ()
