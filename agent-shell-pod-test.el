(ert-deftest agent-shell-pod-test-close-session ()
  (agent-shell-pod-test--with-env
    (let* ((repo (agent-shell-pod-test--repo tmp "acme"))
           (a (agent-shell-pod-test--session repo "First"))
           (b (agent-shell-pod-test--session repo "Second")))
      (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t))
                ((symbol-function 'completing-read)
                 (lambda (_p choices &rest _)
                   (car (seq-find (lambda (c) (eq (cdr c) b)) choices)))))
        (with-current-buffer a
          (agent-shell-pod-close-session))
        (should-not (buffer-live-p a))
        (let ((default-directory repo))
          (with-temp-buffer
            (setq default-directory repo)
            (should (agent-shell-pod--menu-has-session-p))
            (agent-shell-pod-close-session)))
        (should-not (buffer-live-p b))
        (with-temp-buffer
          (setq default-directory repo)
          (should-not (agent-shell-pod--menu-has-session-p)))))))

